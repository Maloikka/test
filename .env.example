# Скопируй в .env и заполни своими значениями. Файл .env закоммичен в .gitignore.

# --- Идентификация приложения ---
BUNDLE_ID=com.yourcompany.regionfiller
TEAM_ID=ABCDE12345
APPLE_ID=you@example.com

# --- App Store Connect API (для fastlane / CI / TestFlight) ---
# Создаётся в App Store Connect → Users and Access → Integrations → App Store Connect API.
# Роль: App Manager.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# --- Provisioning profile (если не используешь fastlane match) ---
# Имя как в Apple Developer Portal или в Keychain.
PROVISIONING_PROFILE_NAME=RegionFiller AppStore

# --- match (опционально, рекомендуемый способ хранить сертификаты) ---
# MATCH_GIT_URL=git@github.com:you/ios-certificates.git
# MATCH_PASSWORD=...
