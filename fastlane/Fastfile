default_platform(:ios)

# Использование (на Mac с Xcode):
#
#   bundle install            # один раз — поставит fastlane
#   bundle exec fastlane beta # собрать .ipa и залить в TestFlight
#
# Перед первым запуском заполнить .env (или fastlane/.env.default):
#
#   BUNDLE_ID=com.yourcompany.regionfiller
#   TEAM_ID=ABCDE12345
#   APPLE_ID=you@example.com               # email Apple Developer аккаунта
#   ASC_KEY_ID=XXXXXXXXXX                  # ID ключа App Store Connect API
#   ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-...   # Issuer ID App Store Connect
#   ASC_KEY_PATH=./AuthKey_XXXXXXXXXX.p8   # путь к .p8 файлу с ключом
#
# match (рекомендуемый способ хранить сертификаты в private git-репо):
#   bundle exec fastlane match appstore --git_url git@github.com:you/certs.git
#
# Если match лень настраивать — используй :beta_local, она подпишет
# уже установленным в Keychain сертификатом.

platform :ios do
  before_all do
    sh("which xcodegen || brew install xcodegen")
    sh("cd .. && xcodegen generate")
  end

  desc "Build & upload to TestFlight (рекомендуемый путь, через App Store Connect API + match)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "RegionFiller.xcodeproj"
    )

    match(
      type: "appstore",
      app_identifier: ENV["BUNDLE_ID"],
      readonly: true,
      api_key: api_key
    ) if ENV["MATCH_GIT_URL"]

    build_app(
      project: "RegionFiller.xcodeproj",
      scheme: "RegionFiller",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "RegionFiller.ipa",
      export_options: {
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => ENV["PROVISIONING_PROFILE_NAME"] || "match AppStore #{ENV["BUNDLE_ID"]}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/RegionFiller.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Region Filler — генератор данных под смену региона Apple ID."
    )
  end

  desc "Локальная сборка .ipa без аплоада в TestFlight (нужен Mac с Xcode + сертификат в Keychain)"
  lane :ipa_local do
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "RegionFiller.xcodeproj"
    )

    build_app(
      project: "RegionFiller.xcodeproj",
      scheme: "RegionFiller",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "RegionFiller.ipa"
    )

    UI.success("✅ .ipa собран в build/RegionFiller.ipa")
  end
end
